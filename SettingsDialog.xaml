<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
	x:Class="ViscaIP.SettingsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:ViscaIP"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<StackPanel>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="160" />
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="100" />
				<ColumnDefinition Width="100" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Orientation="Horizontal">
				<TextBox IsReadOnly="True" Text="Camera" />
				<ComboBox x:Name="cameraCombo" SelectionChanged="cameraCombo_SelectionChanged" ></ComboBox>
			</StackPanel>
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button x:Name="addBtn" Content="Add" Click="AddClick" Background="Azure" Foreground="Black" />
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal">
				<Button x:Name="saveBtn" Content="Save" Click="SaveClick" Background="Azure" Foreground="Black" />
			</StackPanel>
			<StackPanel Grid.Column="3" Orientation="Horizontal">
				<Button x:Name="deleteBtn" Content="Delete" Click="DeleteClick" Background="Azure" Foreground="Black" />
			</StackPanel>
		</Grid>
		<StackPanel Orientation="Vertical">
			<StackPanel Orientation="Horizontal">
				<TextBox IsReadOnly="True" Text="IP Address" />
				<TextBox x:Name="ipAddressTxt" />
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<TextBox IsReadOnly="True" Text="Port" />
				<TextBox x:Name="portTxt" />
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<TextBox IsReadOnly="True" Text="Name" />
				<TextBox x:Name="nameTxt" />
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<TextBox IsReadOnly="True" Text="Camera Model" />
				<ComboBox x:Name="modelCombo" />
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<CheckBox x:Name="miniCheck" Content="Mini Disp" Checked="miniCheck_Checked" Unchecked="miniCheck_Unchecked"/>
				<CheckBox x:Name="commsCheck" Content="Show Comms" Checked="commsCheck_Checked" Unchecked="commsCheck_Unchecked"/>
				<CheckBox x:Name="logCheck" Content="Keep Log" Checked="logCheck_Checked" Unchecked="logCheck_Unchecked"/>
			</StackPanel>
		</StackPanel>
	</StackPanel>	
	
</ContentDialog>
